{
  "name": "pi-provider-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-scoped HTTP proxying for selected Pi model providers",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "proxy",
    "openai-codex",
    "xai"
  ],
  "scripts": {
    "build": "tsc",
    "check": "bun run format:check && bun run typecheck && bun run test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "tsc && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "undici": "8.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.4 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.4 <0.85.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
